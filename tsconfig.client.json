{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "outDir": "dist/client"
  },
  "include": ["src/common/**/*.ts", "src/client/**/*.ts", "src/client/**/*.vue"],
  "exclude": ["node_modules"]
}
