{
  "name": "wingspan",
  "version": "0.1.0",
  "description": "Browser-based Wingspan board game",
  "private": true,
  "scripts": {
    "build:client": "webpack --mode production",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "dev:client": "webpack --mode development --watch",
    "dev:server": "ts-node src/server/server.ts",
    "dev": "webpack --mode development && ts-node src/server/server.ts",
    "start": "node dist/server/server.js",
    "test": "jest",
    "lint": "eslint src/ --ext .ts,.vue"
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "express": "^4.21.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "css-loader": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.0",
    "html-webpack-plugin": "^5.6.0",
    "sass": "^1.80.0",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0",
    "vue-loader": "^17.4.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
}
